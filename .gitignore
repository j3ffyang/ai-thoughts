# Secrets, credentials, keys — never commit or push
.env
.env.*
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
secrets/
credentials/

# Generated video output (final MP4s + scratch work), regenerable via video-gen skill
videos/

# Regenerable image/infographic backups (auto-created when regenerating assets)
imgs/*-backup-*
infographic/**/*-backup-*

# LinkedIn upload artefacts from the md-to-linkedin skill (regenerable, uploaded by hand):
# table screenshots, and the HTML that feeds the clipboard
imgs/linkedin-tables/
*-linkedin.html

# Python bytecode from skill scripts (regenerated on every run)
__pycache__/
*.pyc

# Stray empty SQLite file from a mistyped `sqlite3 AIChat` run in the repo root
/AIChat

# Secrets, credentials, keys — never commit or push
.env
.env.*
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
secrets/
credentials/

# Generated video output (final MP4s + scratch work), regenerable via video-gen skill
videos/

# Regenerable image/infographic backups (auto-created when regenerating assets)
imgs/*-backup-*
infographic/**/*-backup-*

# LinkedIn table screenshots are throwaway artefacts — uploaded by hand, never
# fetched by URL — so they stay on local disk. The HTML payloads feed the
# clipboard and are regenerable too. Medium's table PNGs are the exception: they
# are committed, because Medium fetches them by URL and drops anything it cannot.
# The X thread text is regenerable as well, and the thread itself lives on X.
imgs/linkedin-tables/
imgs/twitter-blocks/
*-linkedin.html
*-medium.html
*-twitter.txt

# Python bytecode from skill scripts (regenerated on every run)
__pycache__/
*.pyc

# Stray empty SQLite file from a mistyped `sqlite3 AIChat` run in the repo root
/AIChat
